#!/usr/bin/env bash
# Delegate to the maintained Ansible role instead of resetting/cleaning a clone.
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../../.." && pwd)
playbook=neovim-modern.yml
ref=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --system) playbook=neovim.yml ;;
    --tag)
      [[ -n "${2:-}" ]] || { echo '--tag requires a release tag or commit' >&2; exit 1; }
      ref="$2"
      [[ "$ref" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$|^[0-9a-f]{40}$ ]] || { echo 'Use an exact release tag or 40-character commit.' >&2; exit 1; }
      shift ;;
    -h|--help)
      printf 'Usage: build-nvim [--tag vX.Y.Z|COMMIT] [--system]\nDefault: independent pinned HEAD at ~/.local/opt/nvim-modern (no system replacement).\n--system: explicitly replace the system Neovim with the pinned stable DEB.\n'
      exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
  shift
done
command -v uv >/dev/null || { echo 'Install uv first; see ansible/README.md.' >&2; exit 1; }
args=(playbooks/"$playbook" --ask-become-pass)
[[ -z "$ref" ]] || args+=(--extra-vars "neovim_version=$ref")
cd -- "$root/ansible"
exec uv run ansible-playbook "${args[@]}"
