# Generated by Ansible. Configure this tool in its role defaults, not here.
# Loaded by ~/.config/shell/env.sh (from the dotfiles shell package).
{% for name, value in shell_environment_exports | dictsort %}
export {{ name }}={{ value | quote }}
{% endfor %}
{% if shell_environment_paths %}
if command -v shell_prepend_path >/dev/null 2>&1; then
{% for directory in shell_environment_paths %}
    shell_prepend_path {{ directory | quote }}
{% endfor %}
else
    printf '%s\n' "{{ shell_environment_name }}: shell_prepend_path is missing; update the dotfiles shell package" >&2
fi
{% endif %}
